package safeds.lang

/**
 * This parameter should only be used by expert users.
 */
@Experimental
@Targets([AnnotationTarget.Parameter])
annotation Expert

/**
 * The category of a declaration. It can be used for grouping.
 */
@Experimental
@Targets([
    AnnotationTarget.Class,
    AnnotationTarget.Enum,
    AnnotationTarget.Function,
    AnnotationTarget.Segment,
])
annotation Category(category: DataScienceCategory)

/**
 * A step in the data science process.
 * The letter "Q" is used as a separator for subcategories.
 */
@Experimental
enum DataScienceCategory {
    /**
     * Basic building blocks.
     */
    BasicElement

    /**
     * Load your data into the program.
     */
    DataImport

    /**
     * Save your data for later use.
     */
    DataExport

     /**
     * Explore your data.
     */
    DataExplorationQMetric
    DataExplorationQVisualization
    DataExplorationQGeneral

    /**
     * Prepare your data for analysis.
     */
    DataProcessingQColumn
    DataProcessingQTable
    DataProcessingQImage
    DataProcessingQImageList
    DataProcessingQTransformer

    /**
     * Configure a model and train it on your data.
     */
    ModelingQGeneral
    ModelingQClassicalClassification
    ModelingQClassicalRegression
    ModelingQNeuralNetwork

    /**
     * Evaluate the performance of your model.
     */
    ModelEvaluationQMetric
    ModelEvaluationQVisualization

    /**
     * Utility terms for general use and lambda functions.
     */
    UtilitiesQConversion
    UtilitiesQTable
    UtilitiesQImage
    UtilitiesQString
}

/**
 * The phase of the data science pipeline.
 * Is used to define a Behaviour Protocol, which is a set of rules that govern the usage of declarations in a certain phase.
 */
@Experimental
@Targets([
    AnnotationTarget.Class,
    AnnotationTarget.Function
    ])
annotation PipelineActivity(activities: List<DSPipelineActivity>)

@Experimental
enum DSPipelineActivity {
// Pre-Processing Layer
    /**
     * Acquire data: load from external sources, or build a datatype by hand.
     */
    DataAcquisitionQLoading
    DataAcquisitionQDatatypeConstruction

    /**
     * Prepare data before the split: deterministic cleaning, schema edits, EDA, helpers.
     */
    DataPreparationQExploration
    DataPreparationQPreSplitCleaning
    DataPreparationQSchemaModification
    DataPreparationQUtilities

    /**
     * Partition data into training, validation and test sets.
     */
    DataPartitioningQSplit

    /**
     * Process data after the split. Exploration, post-split cleaning and augmentation are training-only.
     */
    DataProcessingQExploration
    DataProcessingQPostSplitCleaning
    DataProcessingQSchemaModification
    DataProcessingQUtilities
    DataProcessingQDataTransformer
    DataProcessingQAugmentation

// Model Building Layer
    /**
     * Do feature engineering to prepare your data for modeling.
     */
    FeatureEngineeringQDatatypeConstruction
    FeatureEngineeringQSchemaModification
    FeatureEngineeringQUtilities
    FeatureEngineeringQEngineering
    FeatureEngineeringQFeatureTransformer

    /**
     * Select features and assemble the dataset for your model.
     */
    FeatureSelectionQSchemaModification
    FeatureSelectionQTabularDatasetConversion

    /**
     * Configure a model.
     */
    ModelingQCreating

    /**
     * Train the model on the training set.
     */
    TrainingQFitting

    /**
     * Predict and score on the validation set, then once on the test set.
     */
    EvaluationQPrediction
    TestingQPrediction
    EvaluationQMetric
    TestingQMetric

    /**
     * Interpret results: inverse-transform predictions back to original units, visualize the model.
     */
    InterpretationQPostProcessing
    InterpretationQVisualization

    /**
     * Can be used as a wildcard.
     */
    Any
}



/**
 * Tags to associate with a declaration. They can be used for filtering.
 */
@Experimental
@Targets([
    AnnotationTarget.Annotation,
    AnnotationTarget.Class,
    AnnotationTarget.Enum,
    AnnotationTarget.Function,
    AnnotationTarget.Pipeline,
    AnnotationTarget.Segment,
])
annotation Tags(tags: List<String>)
