// $TEST$ apply "Add a second split to partition the data into train, validation, and test sets."

package tests.codeActions.quickfixes.addThreeWaySplitWithRename

pipeline testPipeline {
    val rawData = Table.fromCsvFile("titanic.csv");
    val rawTrain, val rawRest = rawData.splitRows(0.6);
    val rawValidation, val rawTest = rawRest.splitRows(0.5);
}
