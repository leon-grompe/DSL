package tests.validation.consistentTransformation.plotOnlyTrainingEscape

pipeline myPipeline {
    val data = Table.fromCsvFile("data.csv");
    val train, val test = data.splitRows(percentageInFirst = 0.7);

    val scaler = StandardScaler().fit(train);
    val imputer = SimpleImputer(SimpleImputer.Strategy.Median).fit(train);

    // model path: the same transform reaches 'toTabularDataset' on both partitions
    val trainScaled = train.transformTable(scaler);
    val testScaled = test.transformTable(scaler);

    // training-only transform whose output feeds a plot, not the model -> escaped, must NOT be flagged
    // $TEST$ no warning r"is not applied on the Test dataset but applied once on the Training dataset"
    val trainForPlot = train.transformTable(imputer);
    val _plot = trainForPlot.plot.histogram();

    val _trainSet = trainScaled.toTabularDataset("label");
    val _testSet = testScaled.toTabularDataset("label");
}
