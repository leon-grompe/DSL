package tests.validation.dataFlow.restSetUsage.chainedMisused

// A real 3-way split: 'rest' is split a second time into validation/test. Because a chained split exists,
// 'rest' is a genuine rest set, so using it for anything other than that second split (here, cleaning it
// directly) IS misuse and must be flagged.
pipeline myPipeline {
    val data = Table.fromCsvFile("data.csv");
    val _train, val rest = data.splitRows(percentageInFirst = 0.6);
    val _validation, val _test = rest.splitRows(percentageInFirst = 0.5);
    // $TEST$ warning "The rest set ('rest') should only be used for a second split, not for anything else."
    val _cleaned = rest.removeRowsWithOutliers();
}
