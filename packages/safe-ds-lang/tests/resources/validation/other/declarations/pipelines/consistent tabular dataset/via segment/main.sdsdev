package tests.validation.consistentTabularDataset.viaSegment

segment toDataset(table: Table) -> dataset: TabularDataset {
    yield dataset = table.toTabularDataset("label");
}

pipeline myPipeline {
    val data = Table.fromCsvFile("data.csv");
    val train, val test = data.splitRows(percentageInFirst = 0.7);
    // $TEST$ no warning r"All 'toTabularDataset' calls in a pipeline must have the same arguments"
    val _trainSet = toDataset(train);
    // $TEST$ no warning r"All 'toTabularDataset' calls in a pipeline must have the same arguments"
    val _testSet = toDataset(test);
}
