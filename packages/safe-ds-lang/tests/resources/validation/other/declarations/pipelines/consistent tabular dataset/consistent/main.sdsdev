package tests.validation.consistentTabularDataset.consistent

pipeline myPipeline {
    val data = Table.fromCsvFile("data.csv");
    val train, val test = data.splitRows(percentageInFirst = 0.7);
    // $TEST$ no warning r"All 'toTabularDataset' calls in a pipeline must have the same arguments"
    val _trainSet = train.toTabularDataset("label", extraNames = ["id"]);
    // $TEST$ no warning r"All 'toTabularDataset' calls in a pipeline must have the same arguments"
    val _testSet = test.toTabularDataset(targetName = "label", extraNames = ["id"]);
}
