package tests.validation.consistentTabularDataset.inconsistentTarget

pipeline myPipeline {
    val data = Table.fromCsvFile("data.csv");
    val train, val test = data.splitRows(percentageInFirst = 0.7);
    val _trainSet = train.toTabularDataset("a");
    // $TEST$ warning r"Inconsistent preprocessing arguments: 'toTabularDataset' uses 'targetName = [^']*' on 'Test' but 'targetName = [^']*' on 'Training'"
    val _testSet = test.toTabularDataset("b");
}
